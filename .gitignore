# ═══════════════════════════════════════════
#  AGS Tutorial — Root .gitignore
# ═══════════════════════════════════════════

# ── Environment Variables (CRITICAL — never commit secrets) ──
.env
.env.local
.env.development
.env.test
.env.production
*.env

# ── Node.js ──
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Build outputs ──
dist/
dist-ssr/
build/

# ── Logs ──
logs/
*.log

# ── OS generated files ──
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editor / IDE ──
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp
*.swo
*~

# ── Misc ──
*.local
.vercel
.netlify
